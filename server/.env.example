# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real secrets.

# Server
PORT=5000
NODE_ENV=development

# Database — MongoDB Atlas (free tier) or local
# Atlas: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/mithilavahan
# Local: mongodb://localhost:27017/mithilavahan
MONGODB_URI=mongodb://localhost:27017/mithilavahan

# Auth
JWT_SECRET=change_this_to_a_long_random_string

# First admin — auto-promoted/created on startup (optional)
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Web Push (VAPID) — optional, enables free browser push notifications
# Generate once: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@mithilavahan.in

# Cloudinary — optional, for vehicle photos / document uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend origin (for CORS in production)
CLIENT_URL=http://localhost:5173
